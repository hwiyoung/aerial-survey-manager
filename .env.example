# Aerial Survey Manager
# Environment variables for Docker Compose

# Database
POSTGRES_PASSWORD=your-secure-password

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Docker Compose project/host entrypoint (production)
COMPOSE_PROJECT_NAME=aerial_survey_manager
HOST_BIND=0.0.0.0
AERIAL_WEB_PORT=18100

# Development compose host ports (docker-compose.yml)
# Production uses 18100; local development uses 18110+ so both can run together.
AERIAL_DEV_WEB_BIND=127.0.0.1
AERIAL_DEV_WEB_PORT=18110
AERIAL_DEV_HTTPS_BIND=127.0.0.1
AERIAL_DEV_HTTPS_PORT=18111
AERIAL_DEV_API_BIND=127.0.0.1
AERIAL_DEV_API_PORT=18101
AERIAL_DEV_DB_BIND=127.0.0.1
AERIAL_DEV_DB_PORT=18132
AERIAL_DEV_REDIS_BIND=127.0.0.1
AERIAL_DEV_REDIS_PORT=18179
AERIAL_DEV_MINIO_BIND=127.0.0.1
AERIAL_DEV_MINIO_PORT=18102
AERIAL_DEV_MINIO_CONSOLE_BIND=127.0.0.1
AERIAL_DEV_MINIO_CONSOLE_PORT=18103
AERIAL_DEV_FLOWER_BIND=127.0.0.1
AERIAL_DEV_FLOWER_PORT=18155

# --- Storage Backend ---
# "local" = 로컬 디스크 (단일 서버, MinIO 불필요)
# "minio" = MinIO/S3 (멀티 서버 또는 S3 호환 스토리지)
STORAGE_BACKEND=local

# 로컬 스토리지 기준 경로 (STORAGE_BACKEND=local 일 때 사용)
# 신규 설치 기본 구조:
#   AERIAL_DATA_ROOT/projects/{project_id}/source/
#   AERIAL_DATA_ROOT/projects/{project_id}/processing/
#   AERIAL_DATA_ROOT/projects/{project_id}/exports/
#   AERIAL_DATA_ROOT/orthomosaic/ 또는 EXPORT_ROOT_PATH/
# Example: /mnt/fastdisk/aerial-survey
LOCAL_STORAGE_PATH=

# MinIO Storage (STORAGE_BACKEND=minio 일 때 사용)
# MinIO 모드 시작: COMPOSE_PROFILES=minio docker compose up -d
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-secure-minio-password
# CRITICAL: S3 Multipart Upload에서 presigned URL 생성에 사용됩니다.
# 브라우저에서 접속하는 nginx 주소와 동일하게 설정해야 합니다 (same-origin 필수)
# 예: 배포에서 http://192.168.10.203:18100 로 접속한다면 MINIO_PUBLIC_ENDPOINT=192.168.10.203:18100
# 예: 개발에서 http://localhost:18110 로 접속한다면 MINIO_PUBLIC_ENDPOINT=localhost:18110
MINIO_PUBLIC_ENDPOINT=

# --- Storage Paths ---
# IMPORTANT: Set these to a drive with sufficient free space (1TB+ recommended)
# 신규 설치는 AERIAL_DATA_ROOT 하나를 기준으로 하위 경로를 파생하는 방식을 권장합니다.
# 기존 설치는 아래 개별 경로 값을 유지해도 됩니다.
AERIAL_DATA_ROOT=

# Project source/processing data path on host (mapped to /data/processing in containers)
# If omitted, docker-compose derives it from AERIAL_DATA_ROOT/projects.
# Example: /mnt/fastdisk/aerial-survey/projects
PROCESSING_DATA_PATH=

# Final orthomosaic COG path on host (mapped to /data/storage/orthomosaic and /data/exports)
# If omitted, docker-compose derives it from AERIAL_DATA_ROOT/orthomosaic.
# Example: /mnt/fastdisk/aerial-survey/orthomosaic
EXPORT_ROOT_PATH=
AUTO_EXPORT_ENABLED=false
AUTO_EXPORT_TARGET_CRS=EPSG:5186

# Container log timezone
TZ=Asia/Seoul

# MinIO data path on host (STORAGE_BACKEND=minio 일 때)
# Example: /mnt/fastdisk/minio-data
MINIO_DATA_PATH=

# Offline map tiles path on host (mapped read-only to /data/tiles)
TILES_PATH=

# --- Processing Engines ---
# EXTERNAL_ENGINE_URL=http://your-external-engine:5000

# GPU processing engine (requires GPU and processing license)
ENGINE_LICENSE_KEY=
ENABLE_GPU_ENGINE=true
ENABLE_ODM_ENGINE=false
ENABLE_EXTERNAL_ENGINE=false
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
# worker-engine은 기본 실행 서비스입니다. COMPOSE_PROFILES=engine / USE_ENGINE은 사용하지 않습니다.
