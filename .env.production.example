# ============================================================
# Aerial Survey Manager - Production Environment Configuration
# 외부 기관 배포용 환경 설정 파일
# ============================================================
#
# 사용법:
#   1. 이 파일을 .env로 복사: cp .env.production.example .env
#   2. 아래 변수들을 실제 환경에 맞게 수정
#   3. docker compose -f docker-compose.prod.yml up -d
#
# 또는 설치 스크립트 사용: ./scripts/install.sh
#

# ============================================================
# Docker Compose 프로젝트명 (변경하지 마세요)
# 이 값이 고정되어야 버전 업그레이드 시 DB/볼륨이 유지됩니다.
# ============================================================
COMPOSE_PROJECT_NAME=aerial_survey_manager

# ============================================================
# [필수] 보안 설정 - 반드시 변경하세요!
# ============================================================

# PostgreSQL 데이터베이스 비밀번호
# 생성 방법: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# JWT 인증 서명 키 (최소 32자 이상)
# 생성 방법: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_AT_LEAST_32_CHARACTER_SECRET_KEY
ALLOW_WEAK_JWT_SECRET=false

# 최초 조직 공동 운영 계정 (DB에 사용자가 없을 때 한 번만 사용)
# ADMIN_* 변수명은 기존 배포 패키지 호환을 위해 유지합니다.
# 비밀번호는 12자 이상이어야 하며 Git에 커밋하지 마세요.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_INITIAL_ADMIN_PASSWORD
ADMIN_NAME=운영 계정

# ============================================================
# [필수] 스토리지 설정
# ============================================================
# "local" = 로컬 디스크 (단일 서버, MinIO 없이 운영)
# "minio" = MinIO/S3 (멀티 서버 또는 S3 호환 스토리지)
#
# 로컬 모드 (기본값, 단일 서버 권장):
#   - 파일이 로컬 디스크에 직접 저장됨
#   - MinIO 불필요 → 리소스 절약, 처리 속도 향상
#
# MinIO 모드:
#   - 별도 S3 스토리지 서비스 사용
#   - 멀티 서버 또는 클라우드 환경에 적합
#   - COMPOSE_PROFILES=minio 으로 MinIO 서비스 활성화 필요
STORAGE_BACKEND=local

# MinIO (S3 호환 저장소) 인증 정보 (STORAGE_BACKEND=minio 일 때만 필요)
MINIO_ACCESS_KEY=aerial-admin
# 생성 방법: openssl rand -base64 32
MINIO_SECRET_KEY=CHANGE_THIS_TO_SECURE_MINIO_SECRET

# ============================================================
# [필수] 네트워크 설정
# ============================================================

# 접속 도메인 (DNS 또는 IP)
# 기본 배포는 내부망 접속을 허용합니다.
# 배포PC에서만 접속하게 제한하려면 HOST_BIND를 127.0.0.1로 변경하세요.
# 예: app.example.com 또는 192.168.1.100
DOMAIN=localhost

# 호스트 공개 주소/포트 (nginx/web 진입점 하나만 공개)
HOST_BIND=0.0.0.0
AERIAL_WEB_PORT=18100

# 개발 스택의 Docker 네트워크(172.23.0.0/16)와 분리된 배포용 대역
AERIAL_NETWORK_SUBNET=10.253.0.0/24

# 컨테이너 로그 시간대
TZ=Asia/Seoul

# API와 일반 Celery 서비스가 데이터 파일을 현재 설치 사용자 소유로 생성하도록 합니다.
# 설치 스크립트가 현재 사용자의 UID/GID로 자동 설정합니다.
AERIAL_CONTAINER_UID=1000
AERIAL_CONTAINER_GID=1000

# ============================================================
# [필수] 저장소 경로 설정
# ============================================================
# 신규 배포 패키지는 설치 폴더 아래 ./data를 기본값으로 사용합니다.
# 대용량 외장 디스크를 사용할 때만 절대경로로 변경하세요 (최소 1TB 이상 권장).
# 신규 설치는 아래 기준 경로 하나만 먼저 정하고, 하위 경로를 파생해서 쓰는 것을 권장합니다.
# 기존 설치는 LOCAL_STORAGE_PATH / PROCESSING_DATA_PATH / EXPORT_ROOT_PATH /
# TILES_PATH / MINIO_DATA_PATH 값을 그대로 유지하세요.
AERIAL_DATA_ROOT=./data
#
# 저장 구조 (로컬 모드):
#   AERIAL_DATA_ROOT/projects/{project_id}/source/      ← 업로드 이미지/EO/썸네일
#   AERIAL_DATA_ROOT/projects/{project_id}/processing/  ← 처리 파일, 로그, .work 작업 폴더
#   AERIAL_DATA_ROOT/projects/{project_id}/exports/     ← 프로젝트별 preview/보조 산출물
#   AERIAL_DATA_ROOT/orthomosaic/{region}_{title}.tif  ← 최종 COG 정사영상
#   이름 중복 시 {region}_{title} (1).tif, (2).tif, ...
#   TILES_PATH/                                         ← 오프라인 지도 타일
#
# 저장 구조 (MinIO 모드):
#   MINIO_DATA_PATH/aerial-survey/   ← MinIO 버킷
#   PROCESSING_DATA_PATH/            ← 프로젝트별 처리 파일
#   EXPORT_ROOT_PATH/                ← 최종 COG 정사영상
#   TILES_PATH/                      ← 오프라인 지도 타일

# 로컬 스토리지 기준 경로 (STORAGE_BACKEND=local 일 때)
# 상대경로는 docker-compose.yml이 있는 배포 폴더를 기준으로 합니다.
# 별도 드라이브의 절대경로 사용 시 부팅 순서 설정 필요 → DEPLOYMENT_GUIDE.md 참조
# 컨테이너에는 LOCAL_STORAGE_PATH/projects 만 /data/storage/projects 로 마운트됩니다.
# 최종 정사영상은 EXPORT_ROOT_PATH 가 /data/storage/orthomosaic 로 마운트되므로
# LOCAL_STORAGE_PATH/orthomosaic 더미 디렉토리는 만들 필요가 없습니다.
LOCAL_STORAGE_PATH=./data

# MinIO 데이터 경로 (STORAGE_BACKEND=minio 일 때)
MINIO_DATA_PATH=./data/minio

# 프로젝트별 처리/소스 데이터 경로
PROCESSING_DATA_PATH=./data/projects

# 최종 정사영상 COG 저장 경로
# 파일은 이 폴더 바로 아래에 {region}_{title}.tif 형식으로 저장됩니다.
# 이름이 이미 있으면 {region}_{title} (1).tif, (2).tif 순서로 저장됩니다.
EXPORT_ROOT_PATH=./data/orthomosaic
AUTO_EXPORT_ENABLED=false
AUTO_EXPORT_TARGET_CRS=EPSG:5186

# 프로젝트 처리 로그: processing.log 50MB + 백업 3개
PROCESSING_LOG_MAX_BYTES=52428800
PROCESSING_LOG_BACKUP_COUNT=3
# 오류 진단 묶음: 30일, 프로젝트당 최근 20개, 전체 20GB
PROCESSING_ERROR_BUNDLE_RETENTION_DAYS=30
PROCESSING_ERROR_BUNDLE_PROJECT_LIMIT=20
PROCESSING_ERROR_BUNDLE_TOTAL_MAX_BYTES=21474836480
# 각 오류 묶음에 담는 로그 파일별 최근 최대 5MB
PROCESSING_ERROR_BUNDLE_LOG_TAIL_BYTES=5242880

# 표준 카메라 IO 영속 설정/백업 경로 (io.csv, backups/)
CONFIG_DATA_PATH=
CAMERA_IO_BACKUP_COUNT=20

# 오프라인 타일맵 경로 (배경지도 타일)
TILES_PATH=./data/tiles

# 서버 파일 선택/저장공간 표시 기준
# 기본값은 /media 아래의 연결된 저장장치만 사용자에게 보여줍니다.
MEDIA_STORAGE_ROOT=/media
SYSTEM_STORAGE_PATH=/
FILESYSTEM_ALLOWED_ROOTS=/media

# ============================================================
# [필수] 라이선스 설정
# ============================================================

# 처리 엔진 라이선스 키 (정사영상 처리용)
# 라이선스가 없으면 처리 기능을 사용할 수 없습니다
ENGINE_LICENSE_KEY=

# GPU 처리 엔진은 현재 compose에서 기본 실행됩니다.
# COMPOSE_PROFILES=engine 또는 USE_ENGINE 값은 이 배포 스택에서 사용하지 않습니다.
ENABLE_GPU_ENGINE=true
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================
# [선택] 고급 설정
# ============================================================

# 운영 기본값에서는 DB/Redis/MinIO/Flower 포트를 host에 공개하지 않습니다.
# Flower를 임시로 볼 때만 debug profile 사용:
#   docker compose --profile debug up -d flower-debug
#   http://127.0.0.1:18055

# ============================================================
# [선택] 오프라인 지도 설정
# ============================================================
# 인터넷 없이 지도를 표시하려면 오프라인 타일 데이터가 필요합니다.
# 타일 형식: {TILES_PATH}/{z}/{x}/{y}.jpg 또는 .png (OSM 형식)
# TILES_PATH는 위의 저장소 경로 설정에서 지정합니다.
#
# 프로덕션 기본값: true (오프라인 모드)
# 개발환경 기본값: false (온라인 모드 - OpenStreetMap 사용)

# 오프라인 타일맵 사용 여부 (true/false)
# 프로덕션에서는 기본값이 true입니다 (인터넷 없는 환경 고려)
VITE_MAP_OFFLINE=true

# 오프라인 타일 URL 패턴 (기본값 사용 권장)
# 기본값: /tiles/{z}/{x}/{y} (확장자 없음 - nginx가 .jpg/.png 자동 감지)
# VITE_TILE_URL=/tiles/{z}/{x}/{y}

# ============================================================
# [선택] SSL/HTTPS 설정
# ============================================================
# SSL 인증서는 ./ssl/ 디렉토리에 배치
# - ./ssl/cert.pem : 인증서 파일
# - ./ssl/key.pem  : 개인키 파일

# HTTPS 포트 (기본값: 443)
# HTTPS_PORT=443

# HTTP를 HTTPS로 리다이렉트 (true/false)
# SSL_REDIRECT=true
